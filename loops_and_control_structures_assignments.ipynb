    "n = int(input(\"Enter number of rows: \"))\n",
    "\n",
    "for i in range(n):\n",
    "    row = []\n",
    "    c = 1\n",
    "    for k in range(i + 1):\n",
    "        row.append(str(c))\n",
    "        c = c * (i - k) // (k + 1)\n",
    "    print(\" \" * (n - i - 1) + \" \".join(row))"
