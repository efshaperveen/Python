    "# Problem 6.6: Strong Number Checker\n",
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "original = n\n",
    "total = 0\n",
    "while n > 0:\n",
    "    digit = n % 10\n",
    "    fact = 1\n",
    "    for i in range(1, digit + 1):\n",
    "        fact *= i\n",
    "    total += fact\n",
    "    n //= 10\n",
    "\n",
    "if total == original:\n",
    "    print(original, \"is a Strong number\")\n",
    "else:\n",
    "    print(original, \"is not a Strong number\")"
