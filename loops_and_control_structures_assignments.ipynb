    "# Problem 11.10: Sudoku Validator\n",
    "def is_valid_sudoku(grid):\n",
    "    full_set = set(range(1, 10))\n",
    "\n",
    "    # (1) Check each row\n",
    "    for row in grid:\n",
    "        if set(row) != full_set:\n",
    "            return False\n",
    "\n",
    "    # (2) Check each column\n",
    "    for col in range(9):\n",
    "        if set(grid[row][col] for row in range(9)) != full_set:\n",
    "            return False\n",
    "\n",
    "    # (3) Check each 3x3 box\n",
    "    for box_row in range(0, 9, 3):\n",
    "        for box_col in range(0, 9, 3):\n",
    "            box = set()\n",
    "            for i in range(3):\n",
    "                for j in range(3):\n",
    "                    box.add(grid[box_row + i][box_col + j])\n",
    "            if box != full_set:\n",
    "                return False\n",
    "\n",
    "    return True\n",
    "\n",
    "\n",
    "sudoku = [\n",
    "    [5, 3, 4, 6, 7, 8, 9, 1, 2],\n",
    "    [6, 7, 2, 1, 9, 5, 3, 4, 8],\n",
    "    [1, 9, 8, 3, 4, 2, 5, 6, 7],\n",
    "    [8, 5, 9, 7, 6, 1, 4, 2, 3],\n",
    "    [4, 2, 6, 8, 5, 3, 7, 9, 1],\n",
    "    [7, 1, 3, 9, 2, 4, 8, 5, 6],\n",
    "    [9, 6, 1, 5, 3, 7, 2, 8, 4],\n",
    "    [2, 8, 7, 4, 1, 9, 6, 3, 5],\n",
    "    [3, 4, 5, 2, 8, 6, 1, 7, 9],\n",
    "]\n",
    "\n",
    "print(\"Grid 1:\", \"Valid Sudoku\" if is_valid_sudoku(sudoku) else \"Invalid Sudoku\")\n",
    "\n",
    "# Change one cell to create a duplicate and test again\n",
    "sudoku[0][0] = 3\n",
    "print(\"Grid 2:\", \"Valid Sudoku\" if is_valid_sudoku(sudoku) else \"Invalid Sudoku\")"
   ]
