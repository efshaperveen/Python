    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "square = n * n\n",
    "digits = len(str(n))\n",
    "\n",
    "right = square % (10 ** digits)\n",
    "left = square // (10 ** digits)\n",
    "\n",
    "print(f\"Square = {square}, Left = {left}, Right = {right}\")\n",
    "if left + right == n:\n",
    "    print(n, \"is a Kaprekar number\")\n",
    "else:\n",
    "    print(n, \"is not a Kaprekar number\")"
