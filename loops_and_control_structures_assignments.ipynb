    "# Problem 11.3: Spiral Matrix\n",
    "n = int(input(\"Enter size of matrix (n x n): \"))\n",
    "\n",
    "matrix = [[0] * n for _ in range(n)]\n",
    "top, bottom, left, right = 0, n - 1, 0, n - 1\n",
    "num = 1\n",
    "\n",
    "while top <= bottom and left <= right:\n",
    "    for j in range(left, right + 1):          # left to right\n",
    "        matrix[top][j] = num\n",
    "        num += 1\n",
    "    top += 1\n",
    "\n",
    "    for i in range(top, bottom + 1):          # top to bottom\n",
    "        matrix[i][right] = num\n",
    "        num += 1\n",
    "    right -= 1\n",
    "\n",
    "    if top <= bottom:\n",
    "        for j in range(right, left - 1, -1):  # right to left\n",
    "            matrix[bottom][j] = num\n",
    "            num += 1\n",
    "        bottom -= 1\n",
    "\n",
    "    if left <= right:\n",
    "        for i in range(bottom, top - 1, -1):  # bottom to top\n",
    "            matrix[i][left] = num\n",
    "            num += 1\n",
    "        left += 1\n",
    "\n",
    "for row in matrix:\n",
    "    for value in row:\n",
    "        print(f\"{value:3}\", end=\" \")\n",
    "    print()"
   ]
