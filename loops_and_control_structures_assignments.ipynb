    "# Problem 1.2: Leap Year Checker\n",
    "year = int(input(\"Enter a year: \"))\n",
    "\n",
    "if year % 400 == 0:\n",
    "    print(year, \"is a Leap year\")\n",
    "elif year % 100 == 0:\n",
    "    print(year, \"is not a Leap year\")\n",
    "elif year % 4 == 0:\n",
    "    print(year, \"is a Leap year\")\n",
    "else:\n",
    "    print(year, \"is not a Leap year\")"
   ]
