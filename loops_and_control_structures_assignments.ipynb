    "n = int(input(\"Enter a positive integer: \"))\n",
    "\n",
    "if n < 1:\n",
    "    print(\"Please enter a positive integer\")\n",
    "else:\n",
    "    steps = 0\n",
    "    print(n, end=\"\")\n",
    "    while n != 1:\n",
    "        if n % 2 == 0:\n",
    "            n = n // 2\n",
    "        else:\n",
    "            n = 3 * n + 1\n",
    "        steps += 1\n",
    "        print(\" ->\", n, end=\"\")\n",
    "    print()\n",
    "    print(\"Steps:\", steps)"
   ]
