    "# Problem 11.5: Twin Primes\n",
    "def is_prime(num):\n",
    "    if num < 2:\n",
    "        return False\n",
    "    for i in range(2, int(num ** 0.5) + 1):\n",
    "        if num % i == 0:\n",
    "            return False\n",
    "    return True\n",
    "\n",
    "\n",
    "n = int(input(\"Enter n: \"))\n",
    "\n",
    "print(f\"Twin prime pairs up to {n}:\")\n",
    "for i in range(2, n - 1):\n",
    "    if is_prime(i) and is_prime(i + 2):\n",
    "        print((i, i + 2), end=\" \")\n",
    "print()"
   ]
