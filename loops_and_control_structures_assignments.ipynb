    "# Problem 4.6: Diamond Pattern\n",
    "n = int(input(\"Enter number of rows (odd): \"))\n",
    "\n",
    "half = (n + 1) // 2\n",
    "\n",
    "# Upper half (pyramid)\n",
    "for i in range(1, half + 1):\n",
    "    print(\" \" * (half - i) + \"*\" * (2 * i - 1))\n",
    "\n",
    "# Lower half (inverted pyramid)\n",
    "for i in range(half - 1, 0, -1):\n",
    "    print(\" \" * (half - i) + \"*\" * (2 * i - 1))"
