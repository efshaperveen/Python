    "# Problem 7.2: Caesar Cipher\n",
    "def caesar(text, shift):\n",
    "    result = \"\"\n",
    "    for ch in text:\n",
    "        if ch.isupper():\n",
    "            result += chr((ord(ch) - ord(\"A\") + shift) % 26 + ord(\"A\"))\n",
    "        elif ch.islower():\n",
    "            result += chr((ord(ch) - ord(\"a\") + shift) % 26 + ord(\"a\"))\n",
    "        else:\n",
    "            result += ch\n",
    "    return result\n",
    "\n",
    "\n",
    "message = input(\"Enter message: \")\n",
    "shift = int(input(\"Enter shift value: \"))\n",
    "choice = input(\"Encrypt or Decrypt? (e/d): \").lower()\n",
    "\n",
    "if choice == \"e\":\n",
    "    print(\"Encrypted message:\", caesar(message, shift))\n",
    "elif choice == \"d\":\n",
    "    print(\"Decrypted message:\", caesar(message, -shift))\n",
    "else:\n",
    "    print(\"Invalid choice! Enter 'e' or 'd'.\")"
   ]
