    "# Problem 6.3: Perfect Number Checker\n",
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "divisor_sum = 0\n",
    "for i in range(1, n):\n",
    "    if n % i == 0:\n",
    "        divisor_sum += i\n",
    "\n",
    "if n > 0 and divisor_sum == n:\n",
    "    print(n, \"is a perfect number\")\n",
    "else:\n",
    "    print(n, \"is not a perfect number\")"
   ]
