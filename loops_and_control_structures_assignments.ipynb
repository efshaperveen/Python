    "b = int(input(\"Enter second number: \"))\n",
    "\n",
    "x, y = a, b\n",
    "while y != 0:\n",
    "    x, y = y, x % y\n",
    "gcd = x\n",
    "\n",
    "lcm = (a * b) // gcd\n",
    "print(f\"GCD of {a} and {b} is {gcd}\")\n",
    "print(f\"LCM of {a} and {b} is {lcm}\")"
   ]
