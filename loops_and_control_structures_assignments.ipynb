    "# Problem 3.1: Reverse a Number\n",
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "reverse = 0\n",
    "while n > 0:\n",
    "    digit = n % 10\n",
    "    reverse = reverse * 10 + digit\n",
    "    n = n // 10\n",
    "print(\"Reversed number:\", reverse)"
