    "# Problem 10.29: ISBN Validator\n",
    "isbn = input(\"Enter 10-digit ISBN: \").strip().upper()\n",
    "\n",
    "valid_format = (len(isbn) == 10 and isbn[:9].isdigit()\n",
    "                and (isbn[9].isdigit() or isbn[9] == \"X\"))\n",
    "\n",
    "if not valid_format:\n",
    "    print(\"Invalid ISBN format\")\n",
    "else:\n",
    "    total = 0\n",
    "    weight = 10\n",
    "    i = 0\n",
    "    while i < 10:\n",
    "        value = 10 if isbn[i] == \"X\" else int(isbn[i])\n",
    "        total += value * weight\n",
    "        weight -= 1\n",
    "        i += 1\n",
    "\n",
    "    print(\"Weighted sum:\", total)\n",
    "    if total % 11 == 0:\n",
    "        print(\"Valid ISBN\")\n",
    "    else:\n",
    "        print(\"Invalid ISBN\")"
   ]
