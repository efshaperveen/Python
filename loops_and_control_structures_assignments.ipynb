    "# Problem 7.3: ATM Machine Simulator\n",
    "balance = 10000\n",
    "pin = 1234\n",
    "history = []\n",
    "\n",
    "\n",
    "def add_history(entry):\n",
    "    history.append(entry)\n",
    "    if len(history) > 5:       # keep only last 5 transactions\n",
    "        history.pop(0)\n",
    "\n",
    "\n",
    "# PIN verification (3 attempts)\n",
    "attempts = 0\n",
    "authenticated = False\n",
    "while attempts < 3:\n",
    "    entered = input(\"Enter PIN: \")\n",
    "    if entered == str(pin):\n",
    "        authenticated = True\n",
    "        break\n",
    "    attempts += 1\n",
    "    print(f\"Incorrect PIN. Attempts left: {3 - attempts}\")\n",
    "\n",
    "if not authenticated:\n",
    "    print(\"Card blocked! Too many wrong attempts.\")\n",
    "else:\n",
    "    print(\"Login successful!\")\n",
    "    while True:\n",
    "        print(\"\\n--- ATM Menu ---\")\n",
    "        print(\"1. Check Balance\")\n",
    "        print(\"2. Withdraw Money\")\n",
    "        print(\"3. Deposit Money\")\n",
    "        print(\"4. Change PIN\")\n",
    "        print(\"5. Transaction History\")\n",
    "        print(\"6. Exit\")\n",
    "        choice = input(\"Enter choice (1-6): \")\n",
    "\n",
    "        if choice == \"1\":\n",
    "            print(\"Current balance:\", balance)\n",
    "\n",
    "        elif choice == \"2\":\n",
    "            amount = input(\"Enter amount to withdraw: \")\n",
    "            if not amount.isdigit() or int(amount) <= 0:\n",
    "                print(\"Invalid amount!\")\n",
    "            elif int(amount) > balance:\n",
    "                print(\"Insufficient balance!\")\n",
    "            else:\n",
    "                balance -= int(amount)\n",
    "                add_history(f\"Withdrawn: {amount}\")\n",
    "                print(\"Please collect your cash. New balance:\", balance)\n",
    "\n",
    "        elif choice == \"3\":\n",
    "            amount = input(\"Enter amount to deposit: \")\n",
    "            if not amount.isdigit() or int(amount) <= 0:\n",
    "                print(\"Invalid amount!\")\n",
    "            else:\n",
    "                balance += int(amount)\n",
    "                add_history(f\"Deposited: {amount}\")\n",
    "                print(\"Deposit successful. New balance:\", balance)\n",
    "\n",
    "        elif choice == \"4\":\n",
    "            old = input(\"Enter current PIN: \")\n",
    "            if old == str(pin):\n",
    "                new_pin = input(\"Enter new 4-digit PIN: \")\n",
    "                if new_pin.isdigit() and len(new_pin) == 4:\n",
    "                    pin = int(new_pin)\n",
    "                    add_history(\"PIN changed\")\n",
    "                    print(\"PIN changed successfully!\")\n",
    "                else:\n",
    "                    print(\"Invalid PIN! It must be exactly 4 digits.\")\n",
    "            else:\n",
    "                print(\"Incorrect PIN!\")\n",
    "\n",
    "        elif choice == \"5\":\n",
    "            if not history:\n",
    "                print(\"No transactions yet.\")\n",
    "            else:\n",
    "                print(\"Last transactions:\")\n",
    "                for i, entry in enumerate(history, 1):\n",
