    "# Problem 9.24: Decimal to Binary\n",
    "n = int(input(\"Enter a decimal number: \"))\n",
    "\n",
    "original = n\n",
    "if n == 0:\n",
    "    binary = \"0\"\n",
    "else:\n",
    "    binary = \"\"\n",
    "    for _ in range(n):          # n is always enough iterations\n",
    "        if n == 0:\n",
    "            break\n",
    "        binary = str(n % 2) + binary\n",
    "        n //= 2\n",
    "\n",
    "print(f\"Binary of {original} is {binary}\")"
   ]
