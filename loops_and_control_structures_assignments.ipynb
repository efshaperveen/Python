    "# Problem 3.5: Armstrong Number\n",
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "original = n\n",
    "power = len(str(n))\n",
    "total = 0\n",
    "while n > 0:\n",
    "    digit = n % 10\n",
    "    total += digit ** power\n",
    "    n = n // 10\n",
    "\n",
    "if total == original:\n",
    "    print(original, \"is an Armstrong number\")\n",
    "else:\n",
    "    print(original, \"is not an Armstrong number\")"
   ]
