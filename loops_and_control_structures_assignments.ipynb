    "# Problem 11.8: Sieve of Eratosthenes\n",
    "n = int(input(\"Enter n: \"))\n",
    "\n",
    "is_prime = [True] * (n + 1)\n",
    "is_prime[0] = False\n",
    "if n >= 1:\n",
    "    is_prime[1] = False\n",
    "\n",
    "for i in range(2, int(n ** 0.5) + 1):\n",
    "    if is_prime[i]:\n",
    "        for j in range(i * i, n + 1, i):\n",
    "            is_prime[j] = False\n",
    "\n",
    "print(f\"Prime numbers up to {n}:\")\n",
    "for i in range(2, n + 1):\n",
    "    if is_prime[i]:\n",
    "        print(i, end=\" \")\n",
    "print()"
