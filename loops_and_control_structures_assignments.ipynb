    "# Problem 3.4: Palindrome Checker\n",
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "original = n\n",
    "reverse = 0\n",
    "while n > 0:\n",
    "    reverse = reverse * 10 + n % 10\n",
    "    n = n // 10\n",
    "\n",
    "if original == reverse:\n",
    "    print(original, \"is a palindrome\")\n",
    "else:\n",
    "    print(original, \"is not a palindrome\")"
   ]
