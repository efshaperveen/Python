   "source": [
    "# Problem 6.2: GCD Calculator\n",
    "a = int(input(\"Enter first number: \"))\n",
    "b = int(input(\"Enter second number: \"))\n",
    "\n",
    "x, y = a, b\n",
    "while y != 0:\n",
    "    remainder = x % y\n",
    "    x = y\n",
    "    y = remainder\n",
    "\n",
    "print(f\"GCD of {a} and {b} is {x}\")"
   ]
