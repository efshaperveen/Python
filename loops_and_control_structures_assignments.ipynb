    "# Problem 3.3: Number Guessing Game\n",
    "import random\n",
    "\n",
    "target = random.randint(1, 100)\n",
    "attempts = 0\n",
    "guess = None\n",
    "\n",
    "while guess != target:\n",
    "    guess = int(input(\"Guess the number (1-100): \"))\n",
    "    attempts += 1\n",
    "    if guess > target:\n",
    "        print(\"Too high!\")\n",
    "    elif guess < target:\n",
    "        print(\"Too low!\")\n",
    "    else:\n",
    "        print(f\"Correct! You guessed it in {attempts} attempts.\")"
   ]
